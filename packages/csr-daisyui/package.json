{
  "name": "csr-daisyui",
  "author": "Tegonal Cooperative <info@tegonal.com>",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0",
    "yarn": ">=4.2"
  },
  "homepage": "https://github.com/tegonal/react-router-templates",
  "scripts": {
    "start": "vite preview --host",
    "test": "echo \"Error: no test specified\" && exit 1",
    "up": "yarn upgrade-interactive",
    "dev": "vite --host",
    "build": "vite build --mode development",
    "build:dev": "vite build --mode development",
    "build:test": "vite build --mode test",
    "build:prod": "vite build --mode prod",
    "i18n:extract": "i18next-cli extract && i18next-cli types",
    "i18n:extract:watch": "i18next-cli extract --watch",
    "i18n:extract:ci": "i18next-cli extract --ci --dry-run --quiet",
    "i18n:types": "i18next-cli types",
    "i18n:lint": "i18next-cli lint",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "i18n:generate": "i18next-cli types",
    "prettier": "prettier --write --list-different .",
    "pretty": "prettier --write \"{src,public}/**/*.{ts,tsx,scss,json,html}\"",
    "lint": "eslint --no-warn-ignored app/**/*.{js,ts,jsx,tsx,html}",
    "lint:fix": "eslint --no-warn-ignored app/**/*.{js,ts,jsx,tsx,html} --fix",
    "typecheck": "tsc --build --noEmit",
    "check": "yarn lint:fix && yarn prettier && yarn typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.7",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "27.2.10",
    "i18next-http-backend": "^4.1.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.0",
    "tslog": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@react-router/dev": "^8.5.2",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "daisyui": "^5.8.1",
    "eslint": "^10.15.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "i18next-cli": "^1.91.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-svgr": "^5.2.0"
  },
  "packageManager": "yarn@4.17.0"
}
