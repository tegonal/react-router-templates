{
  "name": "ssr-daisyui",
  "author": "Tegonal Cooperative <info@tegonal.com>",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0",
    "yarn": ">=4.2"
  },
  "homepage": "https://github.com/tegonal/react-router-templates",
  "scripts": {
    "build": "yarn run typecheck && react-router build",
    "dev": "react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint --fix --cache --cache-location ./node_modules/.cache/eslint .",
    "prettier": "prettier --write --list-different .",
    "pretty": "prettier --write \"app/**/*.{js,json,ts,tsx}\"",
    "start": "react-router-serve build/server/index.js",
    "typecheck": "react-router typegen && tsc --version && tsc --build --noEmit",
    "up": "yarn upgrade-interactive",
    "i18n:extract": "i18next-cli extract && i18next-cli types",
    "i18n:extract:watch": "i18next-cli extract --watch",
    "i18n:extract:ci": "i18next-cli extract --ci --dry-run --quiet",
    "i18n:types": "i18next-cli types",
    "i18n:lint": "i18next-cli lint",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "i18n:generate": "i18next-cli types",
    "self-update": "yarn set version latest && yarn",
    "check": "yarn lint:fix && yarn prettier && yarn typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@epic-web/client-hints": "^1.3.9",
    "@epic-web/invariant": "^1.0.0",
    "@hookform/resolvers": "^7.0.7",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@mjackson/form-data-parser": "^0.9.1",
    "@react-router/node": "^8.5.2",
    "@react-router/serve": "^8.5.2",
    "@uidotdev/usehooks": "^2.4.1",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.53.2",
    "i18next": "27.2.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-fetch-backend": "^8.0.0",
    "is-ip": "^5.0.1",
    "isbot": "^5.2.3",
    "lucide-react": "^1.76.0",
    "pretty-cache-header": "^1.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.2",
    "remix-hook-form": "^7.3.0",
    "remix-i18next": "^8.0.0",
    "remix-utils": "^10.0.1",
    "tailwind-merge": "^3.7.0",
    "tslog": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@react-router/dev": "^8.5.2",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "daisyui": "^5.8.1",
    "eslint": "^10.15.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^80.0.0",
    "globals": "^17.14.0",
    "i18next-cli": "^1.91.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-svgr": "^5.2.0"
  },
  "packageManager": "yarn@4.17.0"
}
